datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(uuid())
  username      String       @unique
  email         String       @unique
  passwordHash  String       @map("password_hash")
  avatar        String?
  totpSecret    String?      @map("totp_secret")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  sessions      Session[]
  devices       Device[]
  files         FileMetadata[]
  activities    Activity[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Device {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  deviceName   String   @map("device_name")
  publicKey    String   @map("public_key")
  agentVersion String   @map("agent_version")
  lastSeen     DateTime @default(now()) @map("last_seen")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files        FileMetadata[]

  @@map("devices")
}

model FileMetadata {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  deviceId     String       @map("device_id")
  parentId     String?      @map("parent_id")
  name         String
  relativePath String       @map("relative_path")
  volumeId     Int?         @map("volume_id")
  size         BigInt
  mimeType     String       @map("mime_type")
  extension    String
  isFolder     Boolean      @default(false) @map("is_folder")
  isFavorite   Boolean      @default(false) @map("is_favorite")
  isDeleted    Boolean      @default(false) @map("is_deleted")
  isPrivate    Boolean      @default(false) @map("is_private")
  checksum     String?
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  deletedAt    DateTime?    @map("deleted_at")
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device       Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  parent       FileMetadata? @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     FileMetadata[] @relation("FolderHierarchy")
  activities   Activity[]

  @@map("file_metadata")
}

model Activity {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  action    String
  fileId    String?       @map("file_id")
  metadata  String?
  createdAt DateTime      @default(now()) @map("created_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  file      FileMetadata? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@map("activities")
}

model UploadSession {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  relativePath  String   @map("relative_path")
  totalChunks   Int      @map("total_chunks")
  receivedChunks Int      @default(0) @map("received_chunks")
  checksum      String?
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("upload_sessions")
}

model DownloadSession {
  id            String   @id @default(uuid())
  deviceId      String   @map("device_id")
  relativePath  String   @map("relative_path")
  token         String   @unique
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("download_sessions")
}

model ShareLink {
  id            String   @id @default(uuid())
  fileId        String   @map("file_id")
  token         String   @unique
  passwordHash  String?  @map("password_hash")
  expiresAt     DateTime? @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  readOnly      Boolean   @default(true) @map("read_only")
  accessType    String    @default("PUBLIC") @map("access_type")

  @@map("share_links")
}

model PrivacyRule {
  id           String   @id @default(uuid())
  relativePath String   @unique @map("relative_path")
  isPrivate    Boolean  @default(true) @map("is_private")
  allowedUsers String   @default("[]") @map("allowed_users") // JSON array of user IDs
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("privacy_rules")
}
